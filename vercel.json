{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "functions": {
    "src/main.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/daily-reset",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/cron/appointment-expiry",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/internal/cron/notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/cron/queue-estimation",
      "schedule": "0 6 * * *"
    }
  ]
}