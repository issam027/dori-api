{
  "name": "dori-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:check": "nest build --path tsconfig.quality.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prepare": "husky",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "quality:check": "npm run format:check && npm run lint && npm run typecheck && npm run build:check && npm run uuid:verify && npm test -- --runInBand --coverage=false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:init": "ts-node -r tsconfig-paths/register scripts/db-init.ts",
    "db:init:seed": "ts-node -r tsconfig-paths/register scripts/db-init.ts --seed",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/db-init.ts --seed",
    "db:seed:daily-activity": "ts-node -r tsconfig-paths/register scripts/seed-daily-activity.ts",
    "db:verify": "ts-node -r tsconfig-paths/register scripts/db-verify.ts",
    "db:verify:edge": "ts-node -r tsconfig-paths/register scripts/verify-edge-deployment.ts",
    "perf:seed": "ts-node -r tsconfig-paths/register scripts/performance/perf-seed-runner.ts inject",
    "perf:seed:clean": "ts-node -r tsconfig-paths/register scripts/performance/perf-seed-runner.ts clean",
    "perf:seed:refresh": "ts-node -r tsconfig-paths/register scripts/performance/perf-seed-runner.ts refresh",
    "perf:http": "ts-node -r tsconfig-paths/register scripts/performance/perf-http-runner.ts",
    "perf:explain": "ts-node -r tsconfig-paths/register scripts/performance/perf-explain-runner.ts",
    "swagger:export": "ts-node -r tsconfig-paths/register scripts/swagger-export.ts",
    "uuid:verify": "ts-node -r tsconfig-paths/register scripts/uuid-verify.ts",
    "db:reset": "ts-node -r tsconfig-paths/register scripts/db-init.ts --seed --force"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "js-yaml": "^5.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
