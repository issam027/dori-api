# =============================================================================
# Dori API – Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit the actual .env file to version control.
# =============================================================================
 
# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=dori
DB_PASSWORD=dori_password
DB_NAME=dori
# Set to "true" only in production / when the DB server uses TLS
DB_SSL=false

# ---------------------------------------------------------------------------
# Redis (BullMQ queues + Socket.IO adapter)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty when Redis has no password (default for local dev)
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# For HS256 (development / simple deployments):
#   Set only JWT_SECRET and leave the RSA keys empty.
# For RS256 (recommended for production):
#   Set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY (PEM, single line with \n)
#   and leave JWT_SECRET empty.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARS
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# How long access tokens live (ms / s / m / h / d — vercel/ms format)
JWT_ACCESS_EXPIRES_IN=60m
# How many days a refresh token is valid
REFRESH_TOKEN_EXPIRES_DAYS=30

# ---------------------------------------------------------------------------
# CORS – comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ---------------------------------------------------------------------------
# Database Initialisation (schema + seed)
# Set to "true" ONLY on first boot or in CI to auto-run schema.sql + seed.sql
# ---------------------------------------------------------------------------
AUTO_RUN_MIGRATIONS=false
