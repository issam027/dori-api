# =============================================================================
# Dori API – Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit the actual .env file to version control.
# =============================================================================
 
# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CRON_SECRET=replace-with-a-long-random-secret-for-vercel-cron
DEFAULT_TIMEZONE=Africa/Tunis
APPOINTMENT_EXPIRY_INTERVAL_MINUTES=5
SWAGGER_SERVERS=http://localhost:3000,https://dori-api.vercel.app

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------
# One connection model for local PostgreSQL, Docker, Neon and Vercel.
# Neon: keep sslmode=require in the URL and prefer its pooled endpoint.
DATABASE_URL=postgresql://dori:dori_password@localhost:5432/dori
# Maximum PostgreSQL connections per API instance (Neon pooled endpoint: 10 recommended)
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (Socket.IO adapter + RBAC cache + metrics)
# ---------------------------------------------------------------------------
# Single URL — supports redis://, rediss:// (TLS) and unix sockets.
# Local dev (no auth):        redis://localhost:6379
# Local dev (with password):  redis://default:yourpassword@localhost:6379
# Upstash / Vercel KV:        rediss://default:<token>@<host>:6380
# Set to "disabled" or leave unset on Vercel if Redis is not used.
REDIS_URL=redis://localhost:6379
# Set to "false" to forcefully disable Redis even when REDIS_URL is set.
# REDIS_ENABLED=false

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# For HS256 (development / simple deployments):
#   Set only JWT_SECRET and leave the RSA keys empty.
# For RS256 (recommended for production):
#   Set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY (PEM, single line with \n)
#   and leave JWT_SECRET empty.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARS
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# How long access tokens live (ms / s / m / h / d — vercel/ms format)
JWT_ACCESS_EXPIRES_IN=60m
# How many days a refresh token is valid
REFRESH_TOKEN_EXPIRES_DAYS=30

# Authentication and password hardening
SECURITY_MAX_FAILED_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_BCRYPT_ROUNDS=12

# API rate limits (window in milliseconds, maximum requests per window)
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=2000
THROTTLE_STRICT_TTL_MS=60000
THROTTLE_STRICT_LIMIT=2000
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=100

# Public tracking tokens are also capped by the end of the business day.
TRACKING_TOKEN_TTL_MINUTES=1440
TRACKING_CLOSED_GRACE_MINUTES=60

# ---------------------------------------------------------------------------
# CORS – comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
# Public URL of the web application used in links sent to customers.
PUBLIC_WEB_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database Initialisation (versioned migrations + seed)
# Set to "true" only when this API instance must apply pending migrations.
# ---------------------------------------------------------------------------
AUTO_RUN_MIGRATIONS=false
# DB_SKIP_CREATE=true # For db-init.ts script: skip database creation (auto-detected on Neon/Supabase)

# ---------------------------------------------------------------------------
# Webhooks (Inbound notification validation)
# ---------------------------------------------------------------------------
# WEBHOOK_MAX_AGE_SECONDS=300
# Format: WEBHOOK_SECRET_<PROVIDER>=secret_value (e.g. WEBHOOK_SECRET_TWILIO=...)
# WEBHOOK_SECRET_DEFAULT=change_me

# ---------------------------------------------------------------------------
# Platform (Vercel Serverless)
# ---------------------------------------------------------------------------
# VERCEL=1 is automatically injected by the Vercel platform environment.
# You do NOT need to set it locally unless testing serverless runtime behavior.
# VERCEL=

