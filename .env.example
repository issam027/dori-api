# ==============================================================================
# DORI — Configuration de l'environnement
# ==============================================================================

# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
APP_URL=http://localhost:3000
TRACKING_BASE_URL=https://suivi.dori.tn

# Base de Données (PostgreSQL 16+)
DATABASE_URL=postgresql://dori_user:dori_password@localhost:5432/dori_db?schema=public

# Cache & Files de Tâches (Redis 7+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentification JWT (60 minutes fixe selon §4.12)
JWT_SECRET=super_secret_jwt_key_dori_v3_change_in_production_min32chars
JWT_EXPIRES_IN=3600s
REFRESH_TOKEN_EXPIRES_DAYS=7

# Sécurité & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5
THROTTLE_KIOSK_LIMIT=30
LOCKOUT_MINUTES=15

# Tâches Planifiées
APPOINTMENT_EXPIRY_CRON=*/5 * * * *
DAILY_RESET_DEFAULT_TIME=03:00

# Fournisseur Notifications (Simulation / Dev)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
VOICE_PROVIDER=mock
WEBHOOK_SECRET=dori_webhook_secret_signature_test
