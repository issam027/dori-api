# Copy to .env (ignored by Git). Images must be available on the VM, linux/amd64.
API_IMAGE=dorify/engine:oracle-2026-11-06

# Existing database: reuse its actual password. POSTGRES_PASSWORD does not
# change a password in an already initialized volume.
POSTGRES_PASSWORD=
# URL-encode the password in this URL; use the Docker service name postgres.
DATABASE_URL=
JWT_SECRET=
AUTO_RUN_MIGRATIONS=false

